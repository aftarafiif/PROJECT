// ============================================================
//   RACEDASH v3  –  Arduino Uno + LCD TFT 2.4" (320x240)
//   Library : Adafruit_GFX + MCUFRIEND_kbv
//   Serial  : 9600 baud, format  spd;rpm;tps;suhu;vbatt\n
//   Dummy   : aktif bila tidak ada data 2 detik
// ============================================================

#include <Adafruit_GFX.h>
#include <MCUFRIEND_kbv.h>

MCUFRIEND_kbv tft;

// ── Warna ────────────────────────────────────────────────────
#define C_BG        0x0000
#define C_CARD      0x0861
#define C_TRACK     0x18C3
#define C_BORDER    0x2965

#define C_WHITE     0xFFFF
#define C_LGRAY     0x8C51
#define C_DGRAY     0x2965
#define C_YELLOW    0xEFE0
#define C_RED       0xF800
#define C_ORANGE    0xFC00
#define C_GREEN     0x07E0
#define C_LIME      0xAFE5
#define C_CYAN      0x07FF
#define C_BLUE_C    0x065F
#define C_PURPLE    0xA81F
#define C_PURP2     0xC81F

// ── Dimensi layar ────────────────────────────────────────────
#define SW 320
#define SH 240

// ── Layout ───────────────────────────────────────────────────
#define MG 3

#define HDR_Y  0
#define HDR_H  20

#define SPD_Y  21
#define SPD_H  56

#define RPM_Y  79
#define RPM_H  22

#define SEC1_Y 103
#define SEC1_H 28

#define SEC2_Y 133
#define SEC2_H 28

#define BOT_Y  163
#define BOT_H  46
#define BOT_W  154

// ── Variabel sensor ──────────────────────────────────────────
int    kecepatan = 0, rpm = 0, tps = 0, suhu = 0;
float  vBatt = 0.0;

int    lSpd = -999, lRpm = -999, lTps = -999, lSuhu = -999;
float  lVb  = -999.0;

#define BUF_MAX 48
char   rxBuf[BUF_MAX];
uint8_t rxIdx = 0;

unsigned long lastDataMs    = 0;
unsigned long lapStart      = 0;
unsigned long lastTimerDraw = 0;
unsigned long lastDummy     = 0;

// Dummy animasi
int   dSpd = 0, dRpm = 0, dTps = 0, dSuhu = 75;
float dVb  = 13.5;
int   dDir = 1;

bool wasInDummy = true;

// ── Setup ────────────────────────────────────────────────────
void setup() {
  Serial.begin(9600);

  uint16_t id = tft.readID();
  if (id == 0xD3D3) id = 0x9341;
  tft.begin(id);
  tft.setRotation(3);

  drawLayout();
  lapStart = millis();
}

// ── Loop ─────────────────────────────────────────────────────
void loop() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      if (rxIdx > 0) {
        rxBuf[rxIdx] = '\0';
        parseData(rxBuf);
        rxIdx = 0;
      }
    } else {
      if (rxIdx < BUF_MAX - 1) {
        rxBuf[rxIdx++] = c;
      } else {
        rxIdx = 0;
      }
    }
  }

  if (millis() - lastTimerDraw >= 100) {
    lastTimerDraw = millis();
    drawTimer();
  }

  bool noData = (lastDataMs == 0 || millis() - lastDataMs > 2000);

  if (noData) {
    if (!wasInDummy) {
      lSpd = -999; lRpm = -999; lTps = -999;
      lSuhu = -999; lVb = -999.0;
      wasInDummy = true;
    }
    if (millis() - lastDummy >= 60) {
      lastDummy = millis();
      tickDummy();
    }
  } else {
    if (wasInDummy) {
      lSpd = -999; lRpm = -999; lTps = -999;
      lSuhu = -999; lVb = -999.0;
      wasInDummy = false;
    }
  }

  checkConn();
  delay(4);
}

// ============================================================
//  DUMMY TICKER
// ============================================================
void tickDummy() {
  dSpd += dDir * 2;
  dRpm  = map(dSpd, 0, 200, 800, 5400);
  dTps  = map(dSpd, 0, 200, 5, 98);
  dVb   = 13.5 - (float)dSpd / 400.0;

  if (dSpd >= 200) dDir = -1;
  if (dSpd <= 0)   dDir =  1;

  updateSpeed(dSpd);
  updateRPM(dRpm);
  updateTPS(dTps);
  updateSuhu(dSuhu);
  updateVBatt(dVb);
}

// ============================================================
//  STATIC LAYOUT
// ============================================================
void drawLayout() {
  tft.fillScreen(C_BG);

  // Header
  tft.fillRect(0, HDR_Y, SW, HDR_H, C_CARD);
  tft.drawFastHLine(0, HDR_H, SW, C_BORDER);

  tft.setTextSize(1);
  tft.setTextColor(C_YELLOW, C_CARD);
  tft.setCursor(MG+1, HDR_Y+6);
  tft.print("AKASA");
  tft.setTextColor(C_WHITE, C_CARD);
  tft.print(" EVO 2");

  tft.fillRect(118, HDR_Y+2, 20, 16, C_YELLOW);
  tft.setTextColor(0x0000, C_YELLOW);
  tft.setCursor(124, HDR_Y+6);
  tft.print("N");

  tft.setTextColor(C_LGRAY, C_CARD);
  tft.setCursor(143, HDR_Y+6);
  tft.print("00:00.0");

  tft.fillCircle(SW-7, HDR_Y+10, 4, C_RED);

  // Speed block
  tft.setTextColor(C_DGRAY, C_BG);
  tft.setCursor(SW-28, SPD_Y+2);
  tft.print("km/h");
  tft.fillRect(0, SPD_Y+SPD_H-1, SW, 2, C_TRACK);

  // RPM label
  tft.setTextColor(C_DGRAY, C_BG);
  tft.setCursor(MG, RPM_Y+2);
  tft.print("RPM");
  tft.setCursor(SW-40, RPM_Y+2);
  tft.print("/5500");
  drawRpmLedsEmpty();

  // TPS & SUHU row
  drawSectionLabel(SEC1_Y, "THROTTLE",   C_PURPLE);
  drawSectionLabel(SEC2_Y, "TEMPRATURE", C_CYAN);

  // Battery card
  drawCard(MG, BOT_Y, BOT_W, BOT_H);
  tft.setTextColor(C_DGRAY, C_CARD);
  tft.setCursor(MG+4, BOT_Y+4);
  tft.print("BATTERY");

  // Status card
  int sx = MG + BOT_W + 4;
  drawCard(sx, BOT_Y, BOT_W, BOT_H);
  tft.setTextColor(C_DGRAY, C_CARD);
  tft.setCursor(sx+4, BOT_Y+4);
  tft.print("STATUS");
  tft.setTextColor(C_LGRAY, C_CARD);
  tft.setCursor(sx+4, BOT_Y+16);
  tft.print("DEMO MODE");
  tft.setTextColor(C_DGRAY, C_CARD);
  tft.setCursor(sx+4, BOT_Y+28);
  tft.print("STM32->UNO");
}

void drawCard(int x, int y, int w, int h) {
  tft.fillRect(x, y, w, h, C_CARD);
  tft.drawRect(x, y, w, h, C_BORDER);
}

void drawSectionLabel(int y, const char* lbl, uint16_t accentCol) {
  tft.fillRect(MG, y, 2, SEC1_H-1, accentCol);
  tft.setTextColor(accentCol, C_BG);
  tft.setTextSize(1);
  tft.setCursor(MG+5, y+2);
  tft.print(lbl);
  tft.fillRect(MG+5, y+12, SW-MG*2-5, 5, C_TRACK);
}

void drawRpmLedsEmpty() {
  int lw = (SW - MG*2 - 19*2) / 20;
  int lh = 10;
  int ly = RPM_Y + RPM_H - lh;
  for (int i = 0; i < 20; i++) {
    tft.fillRect(MG + i*(lw+2), ly, lw, lh, C_TRACK);
  }
}

// ============================================================
//  UPDATE FUNCTIONS
// ============================================================

void updateSpeed(int val) {
  val = constrain(val, 0, 999);
  if (val == lSpd) return;
  lSpd = val;

  // Area speed: sisakan 32px kanan untuk "km/h"
  tft.fillRect(MG, SPD_Y+1, SW-MG*2-32, SPD_H-4, C_BG);

  uint16_t col = C_WHITE;
  float rr = (float)rpm / 5500.0;
  if      (rr > 0.90) col = C_RED;
  else if (rr > 0.78) col = C_YELLOW;

  char buf[4];
  sprintf(buf, "%d", val);   // tanpa leading zero

  // ── CENTER OTOMATIS ──────────────────────────────────────
  // TextSize 5: tiap karakter = 6px × 5 = 30px lebar
  // Area yang tersedia: SW - 32 (km/h) - MG*2
  int charW  = 6 * 5;                      // 30px per karakter
  int totalW = strlen(buf) * charW;
  int areaW  = SW - 32 - MG * 2;           // lebar area speed
  int startX = MG + (areaW - totalW) / 2;  // X agar tepat tengah
  // ─────────────────────────────────────────────────────────

  tft.setTextSize(5);
  tft.setTextColor(col, C_BG);
  tft.setCursor(startX, SPD_Y+5);
  tft.print(buf);

  // Progress bar bawah
  int bw = map(constrain(val,0,220), 0, 220, 0, SW);
  tft.fillRect(0,  SPD_Y+SPD_H-1, bw,    2, C_YELLOW);
  tft.fillRect(bw, SPD_Y+SPD_H-1, SW-bw, 2, C_TRACK);

  updateGear(val, rpm);
}

void updateGear(int spd, int r) {
  char g = 'N';
  if (r > 800 && spd > 2) {
    float rat = (float)spd / (float)max(r, 1) * 1000.0;
    if      (rat < 0.8) g = '1';
    else if (rat < 1.4) g = '2';
    else if (rat < 2.1) g = '3';
    else if (rat < 3.0) g = '4';
    else if (rat < 4.2) g = '5';
    else                g = '6';
  }
  uint16_t bc = C_YELLOW, tc = 0x0000;
  if (g == 'N')                     { bc = C_TRACK; tc = C_WHITE; }
  else if ((float)r/5500.0 > 0.88) { bc = C_RED;   tc = C_WHITE; }

  tft.fillRect(118, HDR_Y+2, 20, 16, bc);
  tft.setTextSize(1);
  tft.setTextColor(tc, bc);
  tft.setCursor(124, HDR_Y+6);
  tft.print(g);
}

void updateRPM(int val) {
  val = constrain(val, 0, 9999);
  if (val == lRpm) return;
  lRpm = val;

  tft.fillRect(SW-88, RPM_Y, 46, 11, C_BG);
  tft.setTextSize(1);
  tft.setTextColor(C_WHITE, C_BG);
  tft.setCursor(SW-88, RPM_Y+2);
  char buf[6];
  sprintf(buf, "%5d", val);
  tft.print(buf);

  int lw  = (SW - MG*2 - 19*2) / 20;
  int lh  = 10;
  int ly  = RPM_Y + RPM_H - lh;
  int lit = map(constrain(val,0,5500), 0, 5500, 0, 20);
  for (int i = 0; i < 20; i++) {
    int lx = MG + i*(lw+2);
    uint16_t col = C_TRACK;
    if (i < lit) {
      float r = (float)i / 20.0;
      col = (r < 0.60) ? C_GREEN : (r < 0.85) ? C_YELLOW : C_RED;
    }
    tft.fillRect(lx, ly, lw, lh, col);
  }
}

void updateTPS(int val) {
  val = constrain(val, 0, 100);
  if (val == lTps) return;
  lTps = val;

  int barX = MG+5, barW = SW-MG*2-5;
  uint16_t col = (val<30) ? C_PURPLE : (val<70) ? C_PURP2 : C_RED;

  tft.fillRect(barX, SEC1_Y+12, barW, 5, C_TRACK);
  int bw = map(val, 0, 100, 0, barW);
  if (bw > 0) tft.fillRect(barX, SEC1_Y+12, bw, 5, col);

  tft.fillRect(SW-52, SEC1_Y, 50, 11, C_BG);
  tft.setTextSize(1);
  tft.setTextColor(col, C_BG);
  tft.setCursor(SW-52, SEC1_Y+2);
  char buf[7];
  sprintf(buf, "%3d %%", val);
  tft.print(buf);
}

void updateSuhu(int val) {
  val = constrain(val, 0, 150);
  if (val == lSuhu) return;
  lSuhu = val;

  int barX = MG+5, barW = SW-MG*2-5;
  uint16_t col;
  if      (val < 70) col = C_BLUE_C;
  else if (val < 90) col = C_ORANGE;
  else               col = C_RED;

  tft.fillRect(barX, SEC2_Y+12, barW, 5, C_TRACK);
  int pct = constrain(map(val,20,120,0,100), 0, 100);
  int bw  = map(pct, 0, 100, 0, barW);
  if (bw > 0) tft.fillRect(barX, SEC2_Y+12, bw, 5, col);

  tft.fillRect(SW-52, SEC2_Y, 50, 11, C_BG);
  tft.setTextSize(1);
  tft.setTextColor(col, C_BG);
  tft.setCursor(SW-52, SEC2_Y+2);
  char buf[8];
  sprintf(buf, "%3d", val);
  tft.print(buf);
  tft.print((char)223);  // °
  tft.print('C');
}

void updateVBatt(float val) {
  if (val > lVb - 0.05 && val < lVb + 0.05) return;
  lVb = val;

  int x = MG, iw = BOT_W - 8;

  tft.fillRect(x+4, BOT_Y+14, iw, 14, C_CARD);
  tft.setTextSize(1);
  tft.setTextColor(C_YELLOW, C_CARD);
  tft.setCursor(x+4, BOT_Y+16);
  char buf[8];
  dtostrf(val, 5, 2, buf);
  tft.print(buf);
  tft.print('V');

  int sw2 = (iw-9)/10, sh = 6;
  int sy  = BOT_Y + BOT_H - sh - 4;
  int lit = constrain(map((int)(val*10), 100, 142, 0, 10), 0, 10);
  for (int i = 0; i < 10; i++) {
    int sx2 = x+4+i*(sw2+1);
    uint16_t col = C_TRACK;
    if (i < lit) col = (i<3) ? C_RED : (i<7) ? C_YELLOW : C_GREEN;
    tft.fillRect(sx2, sy, sw2, sh, col);
  }
}

void drawTimer() {
  unsigned long ms = millis() - lapStart;
  uint8_t m = ms/60000, s=(ms%60000)/1000, d=(ms%1000)/100;
  tft.fillRect(143, HDR_Y+4, 58, 11, C_CARD);
  tft.setTextSize(1);
  tft.setTextColor(C_LGRAY, C_CARD);
  tft.setCursor(143, HDR_Y+6);
  char buf[10];
  sprintf(buf, "%02d:%02d.%d", m, s, d);
  tft.print(buf);
}

void checkConn() {
  static bool lConn = false;
  bool conn = (lastDataMs > 0 && millis() - lastDataMs < 3000);
  if (conn == lConn) return;
  lConn = conn;

  tft.fillCircle(SW-7, HDR_Y+10, 4, conn ? C_GREEN : C_RED);

  int sx = MG + BOT_W + 4;
  tft.fillRect(sx+4, BOT_Y+14, BOT_W-8, 12, C_CARD);
  tft.setTextSize(1);
  tft.setTextColor(conn ? C_GREEN : C_RED, C_CARD);
  tft.setCursor(sx+4, BOT_Y+16);
  tft.print(conn ? "LIVE DATA" : "DEMO MODE");
}

// ============================================================
//  PARSE SERIAL
// ============================================================
void parseData(char* data) {
  char tmp[BUF_MAX];
  strncpy(tmp, data, BUF_MAX-1);
  tmp[BUF_MAX-1] = '\0';

  char* tok1 = strtok(tmp,  ";");
  char* tok2 = strtok(NULL, ";");
  char* tok3 = strtok(NULL, ";");
  char* tok4 = strtok(NULL, ";");
  char* tok5 = strtok(NULL, ";");

  if (!tok1 || !tok2 || !tok3 || !tok4 || !tok5) return;

  kecepatan = atoi(tok1);
  rpm       = atoi(tok2);
  tps       = atoi(tok3);
  suhu      = atoi(tok4);
  vBatt     = atof(tok5);

  lastDataMs = millis();

  updateSpeed(kecepatan);
  updateRPM(rpm);
  updateTPS(tps);
  updateSuhu(suhu);
  updateVBatt(vBatt);

  tft.fillCircle(SW-7, HDR_Y+10, 4, C_LIME);
}
